  @media (max-width: 520px) { .bill-row { grid-template-columns: minmax(0, 1fr) 4rem; } .bill-l { grid-column: 1 / -1; } }

  /* the instrument */
  .ils-inst { position: sticky; top: 5.5rem; background: var(--color-ink); color: var(--color-canvas); border-radius: 1rem; padding: 1.1rem 1.15rem; display: grid; gap: 0.75rem; font-family: var(--font-mono); }
