</section>

<style>
  /* Wider than the post column it sits in: centred on the column, never wider than the screen less its gutters. */
  .ils { margin-block: 3rem; width: min(72rem, calc(100vw - 2rem)); margin-inline: calc((100% - min(72rem, calc(100vw - 2rem))) / 2); }
  .ils-grid { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 2.5rem; align-items: start; }
