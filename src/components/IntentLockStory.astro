    .ils-cards { padding-left: 1.6rem; }
    .ils-spine { left: 0.45rem; }
    .ils-card { padding: 1.1rem 1rem; }
    .ils-kind { margin-left: 0; }
  }

  /* motion runs only where the page script is running and motion is welcome */
  .ils.is-live .log-line, .ils.is-live .chk, .ils.is-live .link, .ils.is-live .verdict { opacity: 0.18; transition: opacity 0.35s, transform 0.35s; transform: translateY(4px); }
  .ils.is-live .log-line.on, .ils.is-live .chk.on, .ils.is-live .link.on, .ils.is-live .verdict.on { opacity: 1; transform: none; }
  .ils.is-live .beats i { opacity: 0.18; transition: opacity 0.25s; }
  .ils.is-live .beats i.on { opacity: 1; }
  .ils.is-live .win-spawn { transform: scale(0.6); opacity: 0; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1.05), opacity 0.4s; }
  .ils.is-live .win-spawn.on { transform: none; opacity: 1; }
  .ils.is-live .lamp.allow:not(.on) { background: transparent; border-color: var(--color-line-2); color: var(--color-ink-faint); }
  .ils.is-live .lamp.deny.on { background: var(--color-down); border-color: var(--color-down); color: var(--color-on-accent); }
  .ils.is-live .prose.calm { transform: none; }
  .ils.is-live .qbox.down { transform: translateY(110%); }
  .ils.is-live .screen-cap span { transition: opacity 0.35s; }
  .ils.is-live .screen-cap .off { opacity: 0.2; }
  .ils.is-live .scene-bill.grow .seg { width: 0; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .ils-flow, .caret { animation: none; }
    .ils-packet, .ils-card, .inst-bar span { transition: none; }
