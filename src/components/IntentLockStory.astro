</style>

<script>
  const root = document.querySelector<HTMLElement>('.ils');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    root.classList.add('is-live');
    const states = JSON.parse(root.dataset.states || '[]');
    const cards = [...root.querySelectorAll<HTMLElement>('.ils-card')];
    const packet = root.querySelector<HTMLElement>('.ils-packet');
    const inst = (k: string) => root.querySelector<HTMLElement>(`[data-k="${k}"]`);
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let cur = -1, run = 0, ctxNow = states[0]?.ctx ?? 0, ctxAnim = 0, readNow = states[0]?.read ?? 0, readAnim = 0;

    function countTo(to: number) {
      const el = inst('ctx'); if (!el) return;
      const from = ctxNow; ctxNow = to; const t0 = performance.now(); const id = ++ctxAnim;
      const step = (t: number) => {
        if (id !== ctxAnim) return;
        const p = Math.min(1, (t - t0) / 900);
        el.textContent = fmt(from + (to - from) * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      const bar = inst('bar'); if (bar) bar.style.width = `${Math.min(100, (to / 560000) * 100)}%`;
    }

    function countRead(to: number) {
      const el = inst('read'); if (!el) return;
      const from = readNow; readNow = to; const t0 = performance.now(); const id = ++readAnim;
      const step = (t: number) => {
        if (id !== readAnim) return;
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = fmt(from + (to - from) * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // Each scene loops while its card is current; `live()` stops a loop the moment the reader moves on.
    const scenes: Record<string, (el: HTMLElement, live: () => boolean) => Promise<void>> = {
      mode: async (el, live) => {
        const t = el.querySelector<HTMLElement>('.typed'); if (!t) return;
        const full = t.dataset.text || '';
        while (live()) {
          for (let i = 0; i <= full.length && live(); i++) { t.textContent = full.slice(0, i); await sleep(38); }
          await sleep(2200);
        }
        t.textContent = full;
      },
      inject: (el, live) => stepper(el, '.log-line', 650, live),
      calibrate: async (el, live) => {
        const [a, b] = [...el.querySelectorAll<HTMLElement>('.fork-opt')];
        while (live()) { a.classList.add('pick'); b.classList.remove('pick'); await sleep(1200); a.classList.remove('pick'); b.classList.add('pick'); await sleep(2600); }
        a.classList.remove('pick'); b.classList.add('pick');
      },
      box: async (el, live) => {
        const dots = [...el.querySelectorAll<HTMLElement>('.beats i')];
        while (live()) {
          dots.forEach((d) => d.classList.remove('on'));
          for (const d of dots) { if (!live()) break; d.classList.add('on'); await sleep(140); }
          await sleep(2400);
        }
        dots.forEach((d) => d.classList.add('on'));
      },
      ledger: async (el, live) => {
        const items = [...el.querySelectorAll<HTMLElement>('.led')];
        const count = el.querySelector<HTMLElement>('.led-count b');
        const show = (open: number, n: string) => { items.forEach((it, i) => it.classList.toggle('live', i < open)); if (count) count.textContent = n; };
        while (live()) { show(6, '6'); await sleep(1500); show(4, '4'); await sleep(1500); show(0, '0'); await sleep(2200); }
        show(0, '0');
      },
      restate: async (el, live) => {
        const prose = el.querySelector<HTMLElement>('.prose'); const box = el.querySelector<HTMLElement>('.qbox');
        const [ca, cb] = [...el.querySelectorAll<HTMLElement>('.screen-cap span')];
        while (live()) {
          prose?.classList.add('calm'); box?.classList.add('down'); ca.classList.add('off'); cb.classList.add('off'); await sleep(1300);
          prose?.classList.remove('calm'); box?.classList.remove('down'); ca.classList.remove('off'); await sleep(2600);
          cb.classList.remove('off'); await sleep(2200);
        }
        prose?.classList.remove('calm'); box?.classList.remove('down'); ca.classList.remove('off'); cb.classList.remove('off');
      },
      seal: (el, live) => stepper(el, '.file-line', 550, live),
      gate: async (el, live) => {
        const chks = [...el.querySelectorAll<HTMLElement>('.chk')];
        const deny = el.querySelector<HTMLElement>('.lamp.deny'); const allow = el.querySelector<HTMLElement>('.lamp.allow');
        const [cd, ca] = [...el.querySelectorAll<HTMLElement>('.lamp-cap span')];
        while (live()) {
          chks.forEach((c) => c.classList.remove('on')); allow?.classList.remove('on'); deny?.classList.add('on'); cd.style.opacity = '1'; ca.style.opacity = '0.3';
          await sleep(1600);
          deny?.classList.remove('on'); cd.style.opacity = '0.3';
          for (const c of chks) { if (!live()) break; c.classList.add('on'); await sleep(380); }
          allow?.classList.add('on'); ca.style.opacity = '1'; await sleep(2600);
        }
        chks.forEach((c) => c.classList.add('on')); deny?.classList.remove('on'); allow?.classList.add('on'); cd.style.opacity = ''; ca.style.opacity = '';
      },
      handoff: async (el, live) => {
        const links = [...el.querySelectorAll<HTMLElement>('.link')]; const win = el.querySelector<HTMLElement>('.win-spawn');
        while (live()) {
          links.forEach((l) => l.classList.remove('on')); win?.classList.remove('on');
          for (const l of links) { if (!live()) break; l.classList.add('on'); await sleep(520); }
          win?.classList.add('on'); await sleep(3200);
        }
        links.forEach((l) => l.classList.add('on')); win?.classList.add('on');
      },
      bill: async (el, live) => {
        while (live()) { el.classList.add('grow'); await sleep(60); el.classList.remove('grow'); await sleep(4200); }
        el.classList.remove('grow');
      },
      judge: async (el, live) => {
        const vs = [...el.querySelectorAll<HTMLElement>('.verdict')]; const j = inst('judge');
        const words = ['not yet met', 'not yet met', 'met'];
        while (live()) {
          vs.forEach((v) => v.classList.remove('on'));
          for (let i = 0; i < vs.length && live(); i++) { vs[i].classList.add('on'); if (j) j.textContent = `Haiku 5.5 · ${words[i]}`; await sleep(1300); }
          await sleep(2000);
        }
        vs.forEach((v) => v.classList.add('on'));
      },
    };
    async function stepper(el: HTMLElement, sel: string, ms: number, live: () => boolean) {
      const items = [...el.querySelectorAll<HTMLElement>(sel)];
      while (live()) {
        items.forEach((x) => x.classList.remove('on'));
        for (const x of items) { if (!live()) break; x.classList.add('on'); await sleep(ms); }
        await sleep(2400);
      }
      items.forEach((x) => x.classList.add('on'));
    }
    function lamp(which: '' | 'deny' | 'allow') {
      inst('deny')?.classList.toggle('on', which === 'deny');
      inst('allow')?.classList.toggle('on', which === 'allow');
    }

    function activate(i: number) {
      if (i === cur) return; cur = i; const my = ++run; const s = states[i]; const card = cards[i];
      cards.forEach((c, k) => c.classList.toggle('is-cur', k === i));
      if (packet) packet.style.top = `${card.offsetTop + 22}px`;
      const n = inst('n'); if (n) n.textContent = String(i + 1).padStart(2, '0');
      const title = inst('title'); if (title) title.textContent = card.querySelector('h3')?.textContent || '';
      for (const k of ['mode', 'win', 'round', 'open', 'judge'] as const) { const el = inst(k); if (el) el.textContent = s[k] === 'none' ? 'none yet' : s[k] === 'both' ? 'both, totalled' : s[k]; }
      lamp(s.gate);
      countTo(s.ctx);
      countRead(s.read);
      const alt = inst('alt'); if (alt) alt.textContent = s.win === 'both' ? 'one window, no handoff: 165,519,921' : '';
      const id = card.id.replace('stage-', '');
      const scene = card.querySelector<HTMLElement>('.ils-scene');
      if (scene && scenes[id]) scenes[id](scene, () => my === run);
    }

    // The current stage is the card crossing a line a third of the way down the viewport.
    const io = new IntersectionObserver((entries) => {
      const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (hit) activate(Number((hit.target as HTMLElement).dataset.i));
    }, { rootMargin: '-33% 0px -60% 0px' });
    cards.forEach((c) => io.observe(c));
    activate(0);
  }
</script>
