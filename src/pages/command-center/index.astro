---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import PipelineFlow from '../../components/PipelineFlow.astro';
import { bySlug } from '../../data/sections';
import { liveArchitectures } from '../../data/architectures';
import consoleModules from '../../data/console-modules.generated.json';

const section = bySlug.get('command-center')!;

const principles = [
  { icon: 'network', title: 'Local-first', body: 'No database — the truth is plain JSON files, one per record. Anything that can read files can read (and audit) the whole operation.' },
  { icon: 'radar', title: 'Live', body: 'A file watcher pushes changes to the browser over SSE. The screen moves the instant either the UI or an agent touches anything.' },
  // "Self-briefing" stood here until 2026-09-25; the nightly briefing agent was retired with
  // its module on 2026-08-21, and the console became the briefing: every screen derives
  // its own picture.
  { icon: 'timer', title: 'Derived, not typed', body: 'Screens compute their own picture from the files and from git, so nothing on them is kept current by hand — the estate view reads every repo and app live.' },
  { icon: 'git-branch', title: 'Human-gated', body: 'Agents dispatch, claim, and finish work — but only I move it to done. That gate is enforced in code, not convention.' },
];

/* THE MODULE LIST IS READ, NOT TYPED. It was a fourteen-row literal from 2026-07-08, and
   the console went to seven modules on 2026-08-21 without this page noticing. It now comes
   from Command Center's own registry through the export (collectConsoleModules). */
const modules = consoleModules as { title: string; description: string }[];
const moduleNames = modules.map((m) => m.title.replace(/^The /, '').toLowerCase());
const moduleList = moduleNames.length > 1
  ? `${moduleNames.slice(0, -1).join(', ')} and ${moduleNames[moduleNames.length - 1]}`
  : moduleNames.join('');

---
<PageLayout title="Command Center" description={section.description} image="/og/command-center.png?v=2">
  <section class="section">
    <div class="mx-auto max-w-5xl px-6">
      <div class="max-w-2xl">
        <p class="mono-label">Command Center · the ops console</p>
        <h1 class="mt-2 font-display text-title font-semibold text-ink">
          My private operations console
        </h1>
        <p class="mt-4 font-display text-lg leading-relaxed text-cyan">
          The console is the bridge; Claude Code is the engine room.
        </p>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          A local-first operations console where the UI and the AI work the same files.
          It runs {modules.length} modules — {moduleList} — and the architecture diagrams on
          this site are exported from it. It installs as a PWA on the desktop and rides in a
          native app on my phone.
        </p>
      </div>

      {/* Principles */}
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {principles.map((p) => (
          <div class="panel flex gap-4 p-5">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-line bg-surface-2 text-cyan">
              <Icon name={p.icon} size={19} />
            </span>
            <div>
              <h2 class="font-display text-base font-semibold tracking-tight text-ink">{p.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-ink-muted">{p.body}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Collections */}
      <div class="mt-12">
        <div class="flex items-center gap-3">
          <h2 class="font-display text-head font-semibold text-ink">The modules</h2>
          <span class="h-px flex-1 bg-line"></span>
        </div>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {modules.map((c) => (
            <div class="flex items-baseline gap-3 rounded-lg border border-line bg-surface/50 px-4 py-3">
              <code class="font-mono text-xs text-cyan-deep">{c.title}</code>
              <span class="text-sm text-ink-muted">— {c.description}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Tie-in / safety */}
      <div class="mt-12 panel bg-surface/40 p-6">
        <p class="mono-label">How it ties in here</p>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">
          This public site never connects to the command center live — it's gated and
          private by design. Instead, a reviewed <span class="font-mono text-xs text-cyan-deep">public-safe snapshot</span>
          is exported from it: the {liveArchitectures.length} running architectures you can browse
          here were published through an opt-in gate that strips anything sensitive before it
          ever reaches the web.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/architectures/command-center/" class="btn btn-primary text-sm">
            <Icon name="network" size={15} /> See the architecture
          </a>
          <a href="/tools/" class="btn btn-secondary text-sm">Browse the builds</a>
        </div>
      </div>

      {/* The safe-export pipeline as a living flow */}
      <div class="mt-6">
        <PipelineFlow
          label="The safe-export pipeline — private infrastructure → reviewed public snapshot"
          stages={[
            { name: 'source', note: 'private records' },
            { name: 'export', note: 'field allowlist' },
            { name: 'scrub', note: 'denylist' },
            { name: 'gate', note: 'never ships red', lit: true },
            { name: 'commit', note: 'reviewable diff' },
            { name: 'deploy', note: 'live in ~1 min', lit: true },
          ]}
        />
      </div>
    </div>
  </section>
</PageLayout>
