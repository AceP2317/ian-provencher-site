---
import PageLayout from '../../layouts/PageLayout.astro';
import PipelineFlow from '../../components/PipelineFlow.astro';
import { bySlug } from '../../data/sections';
import { jobs, planningJobs, aiLeadJobs, applyUrl, scoreTone } from '../../data/jobs';
import { profileSummary } from '../../data/job-profile';
import freshness from '../../data/freshness.json';

const section = bySlug.get('jobs')!;

/* THE BOARD RUNS EVERY MORNING (D77, 2026-09-26), after the D65 pause, retargeted to planning
   and AI-lead roles (D75) and resumed (D76); it remembers what it has scored, so a quiet day is cheap. A run that cannot score keeps the prior board rather than
   publishing keyword guesses, so the date below is the last run that CHANGED the board — which is
   why the copy says "last refreshed" and never claims the listings are a few days old.

   THE DATE IS DERIVED, never typed. freshness.json is the one place this repo records when
   a section last refreshed, and check-freshness.mjs --touch moves it — so a by-hand run
   updates this page without anyone remembering to. A literal here would be a second copy of
   one fact kept in step by nothing. Formatted exactly as DataFreshness.astro formats it, so
   the badge at the top and the provenance line at the foot cannot disagree.

   lastChanged, NOT lastReviewed, and they differ. jobs was a 'person' section while its runs
   were paused and is 'pipeline' again since 2026-09-28; either way the badge
   (DataFreshness.astro) and this line both read the date its content last CHANGED.
   This line read lastReviewed and printed 24 Aug under a badge reading 31 Aug, the day
   the last snapshot was actually committed (found 2026-09-25). */
const jobsEntry = freshness.sections.jobs as { lastChanged?: string; lastReviewed: string };
const lastPull = jobsEntry.lastChanged ?? jobsEntry.lastReviewed;
const lastPullPretty = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(lastPull + 'T00:00:00Z'));

/* The tracks are ranked INDEPENDENTLY (D43), so they render as parallel columns rather than one
   stacked above the other — stacking read as "the second category is the lesser one". Built here
   rather than inline so the template can branch on how many tracks actually have rows: on a thin
   day when one comes back empty, a hard-coded two-column grid would render the survivor at half
   width with dead space beside it.

   RETARGETED 2026-09-26 (D75): planning roles that value AI skills, and AI / automation lead roles
   at manufacturers, replacing the three AI-company tracks. `span` stays on the type so a future
   full-width track needs no template change; neither current track uses it.
   D97 (2026-10-09): the AI track counts at makers AND distributors, in three kinds, and MES is gone. */
const tracks = [
  {
    key: 'planning',
    rows: planningJobs,
    heading: 'Supply-chain planning',
    blurb: 'Every supply-chain planning family the search covers, from material and production planning to master data — where the planning depth is the qualification and AI tooling is the edge.',
    span: false,
  },
  {
    key: 'ai-lead',
    rows: aiLeadJobs,
    heading: 'AI and automation roles at makers and distributors',
    blurb: 'AI programs and products in operations, business-partner roles between operations and digital teams, and no-code automation, at companies that make or distribute physical goods. Operations knowledge is what these roles run on.',
    span: false,
  },
].filter((t) => t.rows.length > 0);

/* Only the NON-spanning tracks decide the column count. `span` is applied only when the grid
   actually has two columns: `lg:col-span-2` inside a single-column grid creates an implicit second
   column and breaks the layout. Every literal appears in source so Tailwind's scanner picks it up.
   `items-start` is what lets the shorter column end at its own content instead of stretching. */
const twoCol = tracks.filter((t) => !t.span).length > 1;
const trackGrid = twoCol
  ? 'mt-10 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start'
  : 'mt-10 grid grid-cols-1 gap-10';
---
<PageLayout dataSlug="jobs" title="Job Board" description={section.description} image="/og/jobs.png?v=2">
  <section class="section">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <p class="mono-label">Job Board · {jobs.length}</p>
          <span class="chip border-line-2 text-ink-faint">
            Every morning · last refreshed <time datetime={lastPull}>{lastPullPretty}</time>
          </span>
        </div>
        <h1 class="mt-2 font-display text-title font-semibold text-ink">
          Roles worth a look
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          A pulled, scored shortlist — postings matched against what I actually want
          ({profileSummary.toLowerCase().replace(/\.$/, '')}), each with a fit score and a one-line
          why. Each card opens a web search for the role, so you land on the employer's own posting.
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-muted">
          It refreshes on its own every morning. The last pull that changed it
          ran on <time datetime={lastPull}>{lastPullPretty}</time>, and a role found then may already
          be filled.
        </p>
      </div>

      {/* How the board fills — the aggregator pipeline as a living flow. Undimmed again since the
          schedule came back (D76); it was dimmed like a retired page while the runs were off. */}
      <div class="mt-8">
        <PipelineFlow
          label="How the board fills, every morning"
          stages={[
            { name: 'pull', note: 'many job feeds' },
            { name: 'dedupe', note: 'company + title' },
            { name: 'filter', note: 'my criteria' },
            { name: 'score', note: 'AI fit 0–100', lit: true },
            { name: 'gate', note: 'public-safe' },
            { name: 'board', note: 'top matches', lit: true },
          ]}
        />
      </div>

      {jobs.length === 0 ? (
        <div class="mt-10 panel p-8">
          <p class="mono-label text-ink-faint">No postings yet</p>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">
            The board fills when the fetch runs, every morning: job feeds are pulled,
            filtered to my criteria, scored for fit, and the top matches are committed here. Until a
            run finds roles that clear the fit floor, this stays intentionally empty — no filler,
            no fake listings.
          </p>
        </div>
      ) : (
        <div class={trackGrid}>
          {tracks.map((s) => (
        <section class={s.span && twoCol ? 'lg:col-span-2' : undefined}>
          <div>
            <p class="mono-label text-ink-faint">{s.heading} · {s.rows.length}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.blurb}</p>
          </div>
          <div class="mt-5 flex flex-col gap-4">
          {s.rows.map((j) => (
            <a href={applyUrl(j)} target="_blank" rel="noopener noreferrer"
              class="panel group flex flex-col gap-3 p-5 transition-colors duration-200 hover:border-line-2">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <h2 class="font-display text-lg font-semibold leading-snug tracking-tight text-ink group-hover:text-accent-2">
                    {j.title}
                  </h2>
                  <p class="mt-1 text-sm text-ink-muted">
                    {j.company}{j.via && j.via !== j.company && <span class="text-ink-faint"> (via {j.via})</span>}<span class="text-ink-faint"> · {j.place ?? j.location}</span>
                  </p>
                </div>
                <span class="shrink-0 rounded-lg border border-line bg-surface-2 px-2.5 py-1 font-mono text-xs" style={`color:${scoreTone(j.score)}`}>
                  {j.score}<span class="text-ink-faint">/100</span>
                </span>
              </div>
              <p class="text-sm leading-relaxed text-ink-muted">{j.why}</p>
              <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-1">
                <div class="flex flex-wrap items-center gap-2 text-xs text-ink-faint">
                  {j.salary && <span class="font-mono">{j.salary}</span>}
                  {j.familyLabel && <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 text-[0.65rem] text-ink-muted">{j.familyLabel}</span>}
                  {j.flags.slice(0, 3).map((f) => (
                    <span class="rounded-full border border-line bg-surface-2 px-2 py-0.5 font-mono text-[0.6rem]">{f}</span>
                  ))}
                  <span class="font-mono">{j.source}</span>
                  {j.held && j.seenAt && <span class="font-mono">last seen {new Date(`${j.seenAt}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' })}</span>}
                </div>
                <span class="shrink-0 text-xs font-medium text-cyan-deep group-hover:text-cyan">Find role ↗</span>
              </div>
            </a>
          ))}
          </div>
        </section>
          ))}
        </div>
      )}
    </div>
  </section>
</PageLayout>
