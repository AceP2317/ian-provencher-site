---
/**
 * /stack/hud — the Claude HUD: a terminal strip, its full panel, and a VS Code sidebar.
 *
 * WHY THIS PAGE EXISTS. It did not, until 2026-08-24, while the status-line page described
 * a seven-row instrument that had already been split in two. Until 2026-10-31 it described
 * the sidebar alone, a month after the strip became the display he works in (2026-10-17), and
 * called the sidebar's credential switch current; that card is now kept dimmed and dated (D62).
 *
 * PUBLIC-SAFE (D1): capability and reasoning only — no extension id, no file paths, no
 * account identifiers, and no screenshot of a live session, which would carry a real cwd
 * and a real bill straight through the safe-export gate.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import { hudCards, liveHudCards, statusRows } from '../../data/stack';
const figureWord = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve'][statusRows.length] ?? String(statusRows.length);

const origin = new URL(Astro.site!).origin;
const description =
  'Gauges I built for the Claude Code session in front of me: a strip above the terminal prompt, a full panel one command away, and a VS Code sidebar, all graded by one shared module. Cache warmth, account limits graded by where they land, context pressure and the helpers a session spawned. No server and no port.';

const SCOPE_LABEL: Record<string, string> = {
  account: 'Account-wide',
  conversation: 'This conversation',
  identity: 'Who is working',
};

const DISPLAYS = [
  {
    name: 'The strip',
    where: 'Above the terminal prompt',
    does: 'The effort level, then the cache, the 5-hour, weekly and model windows and the context as small bars with their figures, the resets and the session clock. When a reading needs attention, its alarm leads the row in colour. It refreshes once a minute, after every model response and whenever Claude Code measures the session. By default it hides itself inside VS Code, where the sidebar already shows the same figures.',
  },
  {
    name: 'The full panel',
    where: 'One command, no Claude turn',
    does: 'Every limit with where it lands, when it resets and its burn rate, the week drawn against its plan with a divider at each day, the weekend’s budget, the session’s tokens and cache economics, and every helper with its model, run time and tokens. Typing the command opens it at once, even while a reply is still being written.',
  },
  {
    name: 'The sidebar',
    where: 'In VS Code',
    does: 'The same readings as cards, each marked with its scope, for when the work happens in the editor. It is the original display, and the rules it graded with are the ones the other two now share.',
  },
];

const schema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${origin}/stack/hud/#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Operating Stack', item: `${origin}/stack/` },
      { '@type': 'ListItem', position: 3, name: 'The Claude HUD', item: `${origin}/stack/hud/` },
    ],
  },
];
---
<PageLayout title="The Claude HUD" description={description} image="/og/stack-hud.png?v=3" schema={schema}>
  <section class="relative overflow-hidden">
    <div class="bg-grid bg-grid-fade pointer-events-none absolute inset-0 -z-10 opacity-60"></div>
    <div class="relative mx-auto max-w-4xl px-6 pt-16 pb-6 sm:pt-20">
      <a href="/stack/" class="inline-flex items-center gap-1.5 text-sm text-ink-faint transition-colors hover:text-ink">
        <Icon name="arrow-right" size={14} class="rotate-180" /> Operating Stack
      </a>
      <p class="mono-label mt-6">The Claude HUD · terminal strip and VS Code sidebar</p>
      <h1 class="mt-3 font-display text-title font-semibold text-ink">
        The instrument that watches the session.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        A long agent session spends money and fills a context window whether or not anyone is
        watching, and by the time either one becomes obvious it is already the problem. I built
        this instrument to make both visible while there is still a decision to make. It has three
        displays: a strip of small gauges above the Claude Code prompt, a full panel one command
        away, and a sidebar in VS Code. Since 17 October the terminal strip is the one I work in.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        All three read Claude Code's own files. The limit readings come from the account's usage
        endpoint, signed in as Claude Code already is. My plan is Ultra, and Anthropic
        <a href="https://support.claude.com/en/articles/17728952-what-is-the-ultra-plan" class="link-sweep text-cyan-deep" target="_blank" rel="noopener">removes
        the 5-hour window once it verifies the account</a>; the strip draws a window
        only while the service reports one. Every display shares one refresh slot: the
        first to find the shared reading five minutes old claims it and asks, and the rest read
        what it wrote, however many windows are open. No server, no port, nothing listening.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        The field note <a href="/blog/hud/" class="link-sweep text-cyan-deep">The HUD</a> takes the
        strip apart stage by stage: where each number comes from, and how a reading is graded.
      </p>
    </div>
  </section>

  {/* ── The three displays and the one module they share ───────────────── */}
  <section class="mx-auto max-w-4xl px-6 pb-12">
    <div class="flex items-center gap-3">
      <h2 class="font-display text-head font-semibold text-ink">Three displays, one set of rules</h2>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-mono text-xs text-ink-faint">{DISPLAYS.length}</span>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      {DISPLAYS.map((d) => (
        <div class="panel flex flex-col gap-2 p-5">
          <p class="mono-label">{d.where}</p>
          <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{d.name}</h3>
          <p class="text-sm leading-relaxed text-ink-muted">{d.does}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
      Two displays of one number are how a setup ends up with two half-trusted numbers. So
      <strong class="text-ink"> every rule that decides a colour, a landing or the words of an
      alarm lives in one module</strong>, which reads no file, calls no network and starts no
      process, so its tests drive it with plain values. The sidebar loads that module directly.
      Each terminal display imports a generated copy, and a commit check refuses any commit where a
      copy differs from its source.
    </p>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
      The displays also share their burn-rate history. When each kept its own, they fitted
      different recent rates for the same window, 0.3 and 0.7 percent an hour, and so drew
      different landings from one reading.
    </p>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
      What that module grades is where a window will land at the current pace, not how full it is
      now. Green runs up to the whole allowance, because allowance left unused at the reset is
      waste. Amber starts at 100 percent, and red at 128.6 percent, the landing that the
      weekend's 45 percent ceiling works out to on a week planned to spend 35 percent in its
      first two days.
    </p>
  </section>

  {/* ── The sidebar's cards ────────────────────────────────────────────── */}
  <section class="mx-auto max-w-4xl px-6 pb-12">
    <div class="flex items-center gap-3">
      <h2 class="font-display text-head font-semibold text-ink">What the sidebar shows</h2>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-mono text-xs text-ink-faint">{liveHudCards.length}</span>
    </div>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
      Each card below is marked with its <strong class="text-ink">scope</strong>, because
      the same number means different things at different scales — how much of a five-hour
      account window is gone is a different question from how full this one conversation is, and
      a panel that mixes them teaches you to read neither.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {/* A retired card is DIMMED and DATED, never hidden and never shown as current (D62);
          data-retired is what the retired-copy gate reads. */}
      {hudCards.map((c) => (
        <div
          class={`panel flex flex-col gap-2 p-5${c.retiredOn ? ' opacity-70' : ''}`}
          style={c.retiredOn ? undefined : `border-left: 2px solid var(--color-${c.accent})`}
          data-retired={c.retiredOn}
        >
          <div class="flex items-center gap-2">
            {c.retiredOn ? (
              <span class="chip border-line-2 text-ink-faint">Retired {c.retiredOn}</span>
            ) : (
              <>
                <span class="status-dot" style={`background: var(--color-${c.accent})`}></span>
                <span class="mono-label" style={`color: var(--color-${c.accent})`}>{SCOPE_LABEL[c.scope]}</span>
              </>
            )}
          </div>
          <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{c.title}</h3>
          <p class="text-sm leading-relaxed text-ink-muted">{c.shows}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── The split with the status line ─────────────────────────────────── */}
  <section class="section-band">
    <div class="section mx-auto max-w-4xl px-6">
      <h2 class="font-display text-head font-semibold text-ink">
        Two readouts of one source
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        The HUD and the <a href="/stack/status-line/" class="link-sweep text-cyan-deep">terminal
        status line</a> both describe one session, so they share one source rather than computing
        twice: <strong class="text-ink">the status line keeps a copy of what Claude Code hands it</strong>,
        one file per session, and every HUD display reads that copy.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        {figureWord.replace(/^./, (c) => c.toUpperCase())} figures reach the tool's own status-line command and no transcript records them —
        the cost estimate, its own tally of lines it edited, the percentage used against the real
        window size, the cache read on the request in flight, and the model variant. The terminal
        line shows them at a glance. The HUD takes what it needs from the copy, such as the
        cache's expiry, and adds the rate limits with their landings, cache reuse and the helpers,
        as gauges, where a gauge can say more than a number can.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Without that copy the HUD still renders what it can work out from the transcripts and
        marks the rest as missing, and a test proves it.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="panel panel--well p-5">
          <p class="mono-label">Status line keeps</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {statusRows.map((r) => (
              <li class="flex items-baseline gap-2 text-sm text-ink-muted">
                <span class="font-mono text-[0.6875rem] text-label">{r.tag}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-xs leading-relaxed text-ink-faint">
            No transcript records them; the line copies them for the HUD.
          </p>
        </div>
        <div class="panel panel--well p-5">
          <p class="mono-label">HUD keeps</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {liveHudCards.map((c) => (
              <li class="text-sm text-ink-muted">{c.title}</li>
            ))}
          </ul>
          <p class="mt-3 text-xs leading-relaxed text-ink-faint">
            Everything it can compute for itself.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
