---
/**
 * /stack/hud — the Claude HUD, a VS Code extension.
 *
 * WHY THIS PAGE EXISTS. It did not, until 2026-08-24, while the status-line page described
 * a seven-row instrument that had already been split in two. The half that moved into the
 * editor had no presence on this site at all, which made the whole Operating Stack section
 * a description of a setup that no longer ran.
 *
 * PUBLIC-SAFE (D1): capability and reasoning only — no extension id, no file paths, no
 * account identifiers, and no screenshot of a live session, which would carry a real cwd
 * and a real bill straight through the safe-export gate.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import { hudCards, statusRows } from '../../data/stack';

const origin = new URL(Astro.site!).origin;
const description =
  'A VS Code extension I built: live gauges for the Claude Code session in the window — context pressure, account rate limits, cache warmth and reuse, a per-subagent cost breakdown, and a one-click credential switch. No server, no port, no auth.';

const SCOPE_LABEL: Record<string, string> = {
  account: 'Account-wide',
  conversation: 'This conversation',
  identity: 'Who is working',
};

const schema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${origin}/stack/hud/#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Operating Stack', item: `${origin}/stack/` },
      { '@type': 'ListItem', position: 3, name: 'The Claude HUD', item: `${origin}/stack/hud/` },
    ],
  },
];
---
<PageLayout title="The Claude HUD" description={description} image="/og/stack-hud.png?v=2" schema={schema}>
  <section class="relative overflow-hidden">
    <div class="bg-grid bg-grid-fade pointer-events-none absolute inset-0 -z-10 opacity-60"></div>
    <div class="relative mx-auto max-w-4xl px-6 pt-16 pb-6 sm:pt-20">
      <a href="/stack/" class="inline-flex items-center gap-1.5 text-sm text-ink-faint transition-colors hover:text-ink">
        <Icon name="arrow-right" size={14} class="rotate-180" /> Operating Stack
      </a>
      <p class="mono-label mt-6">The Claude HUD · VS Code extension</p>
      <h1 class="mt-3 font-display text-title font-semibold text-ink">
        The instrument that watches the session.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        A long agent session spends money and fills a context window whether or not anyone is
        watching, and by the time either one becomes obvious it is already the problem. This is a
        VS Code extension I built to make both visible while there is still a decision to make:
        live gauges for the Claude Code session running in that window.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        It computes its figures in the editor process and reads a few files off disk. No server,
        no port, no credentials, nothing listening.
      </p>
    </div>
  </section>

  {/* ── The cards ──────────────────────────────────────────────────────── */}
  <section class="mx-auto max-w-4xl px-6 pb-12">
    <div class="flex items-center gap-3">
      <h2 class="font-display text-head font-semibold text-ink">What it shows</h2>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-mono text-xs text-ink-faint">{hudCards.length}</span>
    </div>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
      Each card's coloured left edge names its <strong class="text-ink">scope</strong>, because
      the same number means different things at different scales — how much of a five-hour
      account window is gone is a different question from how full this one conversation is, and
      a panel that mixes them teaches you to read neither.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {hudCards.map((c) => (
        <div class="reveal panel flex flex-col gap-2 p-5" style={`border-left: 2px solid var(--color-${c.accent})`}>
          <div class="flex items-center gap-2">
            <span class="status-dot" style={`background: var(--color-${c.accent})`}></span>
            <span class="mono-label" style={`color: var(--color-${c.accent})`}>{SCOPE_LABEL[c.scope]}</span>
          </div>
          <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{c.title}</h3>
          <p class="text-sm leading-relaxed text-ink-muted">{c.shows}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── The split, which is the actual design decision ─────────────────── */}
  <section class="section-band">
    <div class="section mx-auto max-w-4xl px-6">
      <h2 class="font-display text-head font-semibold text-ink">
        Two readouts, and neither repeats the other
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        This panel and the <a href="/stack/status-line/" class="link-sweep text-cyan-deep">terminal
        status line</a> both describe one session, which is the setup that usually produces two
        half-trusted numbers for the same thing. So the division is strict rather than tidy:
        <strong class="text-ink">the status line shows only what the HUD physically cannot see</strong>,
        and the panel gave up everything it could not compute for itself.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Five figures reach the tool's own status-line command and are recorded nowhere else, so
        nothing reading a transcript can reproduce them — the billed total, its own tally of lines
        it edited, the percentage used against the real window size, the cache read on the request
        in flight, and the model variant. Those stayed in the terminal. Everything else — the rate
        limits with their pace and projection, cache reuse, the per-agent breakdown — moved here,
        where a gauge can say more than a number can.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
        The panel now needs the status line for nothing at all, and a test proves it: the extension
        is blinded to both files it once read, and is required to render anyway.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="panel panel--well p-5">
          <p class="mono-label">Terminal keeps</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {statusRows.map((r) => (
              <li class="flex items-baseline gap-2 text-sm text-ink-muted">
                <span class="font-mono text-[0.6875rem] text-label">{r.tag}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-xs leading-relaxed text-ink-faint">
            Written nowhere else on the machine.
          </p>
        </div>
        <div class="panel panel--well p-5">
          <p class="mono-label">Panel keeps</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {hudCards.map((c) => (
              <li class="text-sm text-ink-muted">{c.title}</li>
            ))}
          </ul>
          <p class="mt-3 text-xs leading-relaxed text-ink-faint">
            Everything it can compute for itself.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
