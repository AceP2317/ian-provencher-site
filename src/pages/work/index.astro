---
import PageLayout from '../../layouts/PageLayout.astro';
import { bySlug } from '../../data/sections';
import { site } from '../../data/site';
import { aiPicks, workPicks, AI_ROLE_LABEL, ROLE_KIND_LABEL } from '../../data/work';

const section = bySlug.get('work')!;
const lists = [
  {
    key: 'ai',
    heading: 'Applied AI, judged on how I direct it',
    lead: 'Each pick is judged only on its AI: what it delivered, how it was kept honest, and the kind of AI role it proves.',
    rows: aiPicks.map((p) => ({ ...p, chips: p.kinds.map((k) => ROLE_KIND_LABEL[k]) })),
  },
  {
    key: 'supply-chain',
    heading: 'Planning problems, and the AI built around them',
    lead: 'The builds where a supply-chain problem and an AI method meet, each saying how AI touches it.',
    rows: workPicks.map((p) => ({ ...p, chips: [AI_ROLE_LABEL[p.role]] })),
  },
];
---
<PageLayout dataSlug="work" title="Selected work" description={section.description} pageSources={['src/data/work.ts']}>
  <section class="section">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <p class="mono-label">Selected work</p>
        <h1 class="mt-2 font-display text-title font-semibold text-ink">
          {site.role}, ranked by proof
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          Two lists, each ranked by how hard its proof is. The first is my AI work, judged only on
          how I direct the AI in it. The second is the builds where a planning problem and an AI
          method meet. Tools that run on a manufacturer's internal data stay private; the ones with a
          link open now.
        </p>
      </div>

      {lists.map((list) => (
        <div class="mt-14">
          <div class="max-w-2xl">
            <h2 class="font-display text-lg font-semibold tracking-tight text-ink">{list.heading}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{list.lead}</p>
          </div>
          <ol data-list={list.key} class="mt-6 grid grid-cols-1 gap-4">
            {list.rows.map((p, i) => (
              <li class="panel flex flex-col gap-3 p-5 md:flex-row md:gap-6">
                <span class="font-mono text-sm text-ink-faint md:w-8 md:shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <div class="flex min-w-0 flex-col gap-2">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="font-display text-base font-semibold leading-snug tracking-tight text-ink">{p.name}</h3>
                    {p.chips.map((c) => <span class="chip">{c}</span>)}
                  </div>
                  <p class="text-sm leading-relaxed text-ink">{p.evidence}</p>
                  {p.description && <p class="text-sm leading-relaxed text-ink-muted">{p.description}</p>}
                  {p.links.length > 0 && (
                    <div class="flex flex-wrap gap-x-4 gap-y-1 pt-1">
                      {p.links.map((l) => (
                        <a href={l.href} class="inline-flex items-center gap-1 text-xs font-medium text-accent-2 transition-colors hover:text-accent">
                          {l.label} <span aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
