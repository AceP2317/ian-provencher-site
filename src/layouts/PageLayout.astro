---
// PageLayout — the standard chrome wrapper (header + <main> + footer) around
// BaseLayout. Use for every normal page; pass through the SEO props.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchOverlay from '../components/islands/SearchOverlay.jsx';
import DataFreshness from '../components/DataFreshness.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  article?: { publishedTime?: string; modifiedTime?: string; author?: string };
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  rssHref?: string;
  rssTitle?: string;
  /**
   * A key in freshness.json → sections. Pass it on any page whose content is DATA
   * with an age, and the reader gets told how old it is. Stated here, once, so
   * thirteen pages cannot drift into thirteen different provenance lines — and an
   * unknown key renders nothing rather than guessing.
   */
  dataSlug?: string;
  /** For the sections the ledger DERIVES rather than declares — see DataFreshness. */
  dataDate?: string;
}
const { dataSlug, dataDate, ...props } = Astro.props;
---
<BaseLayout {...props}>
  <SiteHeader />
  <main id="main">
    <slot />
    {/* Provenance sits at the END of the content on purpose. It is a footnote a
        reader consults after reading, not a claim competing with the page's own
        heading — and a freshness badge at the top would be the loudest thing on a
        page whose subject is something else entirely. */}
    {dataSlug && (
      <div class="mx-auto max-w-6xl border-t border-line px-6 py-6">
        <DataFreshness slug={dataSlug} date={dataDate} />
      </div>
    )}
  </main>
  <SiteFooter />
  {/* Site-wide search — display:none until opened, so client:idle (not :visible). */}
  <SearchOverlay client:idle />
</BaseLayout>
